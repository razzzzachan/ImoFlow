{
  "name": "immoflow",
  "version": "1.0.0",
  "description": "Sistema completo de CRM imobiliário com IA multimodal e atendimento WhatsApp",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*"
  ],
  "scripts": {
    "setup": "chmod +x scripts/setup.sh && scripts/setup.sh",
    "setup:windows": "scripts\\setup.bat",
    "git:setup": "chmod +x scripts/git-setup.sh && scripts/git-setup.sh",
    "git:setup:windows": "scripts\\git-setup.bat",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspaces",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist",
    "reset": "npm run clean && npm install"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
